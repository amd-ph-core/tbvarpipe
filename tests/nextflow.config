params {
    modules_testdata_base_path        = 'https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/modules/data/'
    nfcore_modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path      = 'https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/tbvarpipe'
    snpeff_db                         = 'mtb_NC_000962_3'
    container_org                     = 'cdc-amd/'
}

docker.registry  = 'quay.io/us-cdcgov'

// Load pipeline container overrides from amd-ph-core/configs
includeConfig "https://raw.githubusercontent.com/amd-ph-core/configs/main/conf/pipeline/tbvarpipe/containers.config"

// Override snpEff config path — when static_assets is set (real pipeline run),
// derive from params.snpeff_cache; otherwise use 'snpeff_cache' (UNTAR output name)
process {
    withName: '.*VARPIPE_SNPEFF_TARGETED' {
        ext.args = { "-config ./${params.static_assets && params.snpeff_cache ? params.snpeff_cache.tokenize('/')[-1] : 'snpeff_cache'}/snpEff.config" }
        ext.prefix = { "${meta.id}_DR_loci_raw_annotation" }
    }

    withName: '.*VARPIPE_SNPEFF_ALL' {
        ext.args = { "-config ./${params.static_assets && params.snpeff_cache ? params.snpeff_cache.tokenize('/')[-1] : 'snpeff_cache'}/snpEff.config" }
        ext.prefix = { "${meta.id}_full_raw_annotation" }
    }
}
