/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run amd-ph-core/tbvarpipe -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '72.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input                      = "https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/tbmainsurveillance/samplesheet/samplesheet.csv"
    metadata                   = null
    static_assets              = null

    // varpipe-wgs
    keepfiles                  = false
    clockwork                  = true

    // Reference files resolve automatically via lazy GStrings in params.config
    // Provide --static_assets at runtime for your environment:
    //   local:  --static_assets /path/to/amd-ph-core-static-assets
    //   CI/S3:  --static_assets s3://amdp-dev-static-assets/amd-ph-core-static-assets
}
